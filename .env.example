# Per-team salt printed on your team slip. Never commit the real value.
DAY1_SALT=change-me
# Day 2 salt from the Day 2 team slip (HMAC key for /audit/v1/*). Never commit the real value.
DAY2_SALT=
# Optional: when set, only the co-stream compositor (sending this as its password) may publish costream/* paths.
MEDIA_PUBLISH_SECRET=
# Wired by docker-compose.yml; override only when running the API outside compose.
REDIS_URL=redis://redis:6379
MEDIA_API_URL=http://mediamtx:9997
NTFY_URL=http://ntfy:80
